# ---- Database ----
POSTGRES_USER=wound_care
POSTGRES_PASSWORD=wound_care
POSTGRES_DB=wound_care
DATABASE_URL=postgresql://wound_care:wound_care@db:5432/wound_care

# ---- AI mode ----
# When MOCK_AI_MODE=true (default), the vision/explainability/notes services
# return deterministic, spec-compliant mock responses — no API key needed.
# Set MOCK_AI_MODE=false AND provide OPENAI_API_KEY to call the real model.
# Flipping this requires no code changes.
MOCK_AI_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- Image storage (local-disk stub for S3/Cloudinary in V1 demo) ----
MEDIA_ROOT=/app/media
MEDIA_BASE_URL=http://localhost:8000/media

# ---- Backend ----
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
